# Copy to .env (git-ignored) and fill in. Run with: flutter run --dart-define-from-file=.env
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Map tiles: a commercial OpenStreetMap tile host (public OSM tiles forbid production use)
MAP_TILE_URL_TEMPLATE=
MAP_TILE_API_KEY=
# Phone code service: fake (default) | whatsapp | firebase | sms
OTP_PROVIDER=
SHARE_BASE_URL=

-- Scratch PostgreSQL 16 only (013 research D15). Stand-ins for what a Supabase
-- stack provides and a plain PostgreSQL lacks: the API roles, auth.users /
-- auth.uid(), the `extensions` schema, and PostGIS types as plain `point`s.
-- NOT part of the product. A run on this shim is reported as
-- "scratch PG16 + shim", never as the real `supabase test db`.
--
-- Spatial functions are crude on purpose (degrees × 111320 m); no test or rule
-- here depends on real geodesy, only on the shapes the migrations call.

-- Roles are cluster-wide, so a second reset must not fail on them.
do $$ begin
  if not exists (select from pg_roles where rolname = 'anon') then create role anon nologin; end if;
  if not exists (select from pg_roles where rolname = 'authenticated') then create role authenticated nologin; end if;
  if not exists (select from pg_roles where rolname = 'service_role') then create role service_role nologin bypassrls; end if;
end $$;

create schema extensions;
create schema auth;
grant usage on schema extensions, auth to anon, authenticated, service_role;

create extension pgcrypto with schema extensions;

create table auth.users (
  id                 uuid primary key default gen_random_uuid(),
  email              text unique,
  aud                text,
  role               text,
  encrypted_password text,
  raw_user_meta_data jsonb not null default '{}'::jsonb,
  created_at         timestamptz not null default now()
);

create function auth.uid() returns uuid language sql stable as $$
  select coalesce(
    nullif(current_setting('request.jwt.claim.sub', true), ''),
    nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub'
  )::uuid
$$;

create function auth.role() returns text language sql stable as $$
  select coalesce(
    nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'role',
    'anon'
  )
$$;

create function auth.jwt() returns jsonb language sql stable as $$
  select coalesce(nullif(current_setting('request.jwt.claims', true), '')::jsonb, '{}'::jsonb)
$$;

grant execute on function auth.uid(), auth.role(), auth.jwt() to anon, authenticated, service_role;

-- PostGIS stand-ins ---------------------------------------------------------------
create domain extensions.geography as point;
create domain extensions.geometry as point;

create function extensions.st_makepoint(double precision, double precision) returns point
  language sql immutable as $$ select point($1, $2) $$;
create function extensions.st_point(double precision, double precision) returns point
  language sql immutable as $$ select point($1, $2) $$;
create function extensions.st_setsrid(point, integer) returns point
  language sql immutable as $$ select $1 $$;
create function extensions.st_x(point) returns double precision
  language sql immutable as $$ select ($1)[0] $$;
create function extensions.st_y(point) returns double precision
  language sql immutable as $$ select ($1)[1] $$;
create function extensions.st_distance(point, point) returns double precision
  language sql immutable as $$ select ($1 <-> $2) * 111320 $$;
create function extensions.st_dwithin(point, point, double precision) returns boolean
  language sql immutable as $$ select ($1 <-> $2) * 111320 <= $3 $$;

grant execute on all functions in schema extensions to anon, authenticated, service_role;

-- pg_cron stand-in: the job text is stored by the real extension and run later;
-- nothing here runs it.
create schema cron;
create function cron.schedule(job_name text, schedule text, command text) returns bigint
  language sql as $$ select 1::bigint $$;

alter database goora_scratch set search_path = "$user", public, extensions;

-- Shared by every *.test.sql (included with \ir). Test users and role switching.
-- pg_temp functions vanish with the session; each test file runs in its own
-- transaction and rolls back.

create or replace function pg_temp.mk_user(p_id uuid, p_first text, p_gender text default 'male',
                                           p_role text default 'rider') returns uuid
  language plpgsql as $$
begin
  insert into auth.users (id, email, aud, role) values (p_id, p_id::text || '@test.goora', 'authenticated', 'authenticated');
  insert into public.profiles (id, first_name, last_name, gender, role) values (p_id, p_first, 'Test', p_gender, p_role);
  return p_id;
end $$;

create or replace function pg_temp.as_user(p_id uuid) returns void
  language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_id, 'role', 'authenticated')::text, true);
  perform set_config('request.jwt.claim.sub', p_id::text, true);
  execute 'set local role authenticated';
end $$;

create or replace function pg_temp.as_anon() returns void
  language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('request.jwt.claim.sub', '', true);
  execute 'set local role anon';
end $$;

create or replace function pg_temp.as_admin() returns void
  language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
end $$;
